<Window x:Class="ClaudeSessionOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeSessionOverlay"
        Title="Claude 세션 오버레이"
        Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 켜기/끄기 스위치: 켜지면 오른쪽으로, 주황 -->
        <Style x:Key="SwitchToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="24" Height="14" CornerRadius="7" Background="{DynamicResource ChipHoverBrush}"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="Knob" Width="10" Height="10" Margin="2,0" HorizontalAlignment="Left"
                                     Fill="{DynamicResource SubtleBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ChipBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="7,1,8,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChipHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PulseDot" TargetType="Ellipse">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPulsing}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Pulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.8"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Pulse"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ContextMenu x:Key="RowMenu" Opened="RowMenu_Opened" Closed="RowMenu_Closed">
            <MenuItem Header="열기" Click="MenuOpen_Click" FontWeight="SemiBold"/>
            <MenuItem Header="확인 처리 (목록에서 숨기기)" Click="MenuSeen_Click"/>
            <MenuItem Header="즐겨찾기 추가/해제" Click="MenuFavorite_Click"/>
            <Separator/>
            <MenuItem Header="폴더 열기" Click="MenuFolder_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Border MouseEnter="Card_MouseEnter" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="12" Padding="6,4,6,6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35"/>
        </Border.Effect>
        <StackPanel>
            <!-- 머리: 끌어서 옮기기 -->
            <Grid x:Name="Header" Height="28" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ContextMenu>
                    <ContextMenu Opened="HeaderMenu_Opened">
                        <MenuItem Header="테마">
                            <MenuItem x:Name="ThemeDarkItem" Header="다크" Tag="Dark" Click="ThemeItem_Click"/>
                            <MenuItem x:Name="ThemeLightItem" Header="라이트" Tag="Light" Click="ThemeItem_Click"/>
                            <MenuItem x:Name="ThemeSystemItem" Header="Windows 설정 따라가기" Tag="System" Click="ThemeItem_Click"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem x:Name="HeaderCollapseItem" Click="HeaderCollapse_Click"/>
                        <MenuItem Header="확인한 세션 다시 보기" Click="HeaderShowSeen_Click"/>
                        <MenuItem Header="트레이로 숨기기" Click="HeaderHide_Click"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Claude 세션" Foreground="{DynamicResource TextBrush}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SummaryText" Foreground="{DynamicResource SubtleBrush}" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- 주간 사용량 바: 계정 단위라 머리 줄에 하나 -->
                <StackPanel x:Name="WeeklyPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed">
                    <TextBlock Text="주간" Foreground="{DynamicResource SubtleBrush}" FontSize="10.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <Border Width="52" Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}" VerticalAlignment="Center">
                        <Border x:Name="WeeklyFill" HorizontalAlignment="Left" CornerRadius="2"/>
                    </Border>
                    <TextBlock x:Name="WeeklyText" FontSize="10.5" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" Content="▴" FontSize="11"
                            ToolTip="접기 (머리 줄만 보기)" Click="Collapse_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="–" ToolTip="최소화 (트레이 아이콘으로 다시 열기)" Click="Minimize_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="✕" FontSize="11" ToolTip="종료" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="Body">
            <ItemsControl x:Name="RowList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:SessionRow}">
                        <StackPanel Opacity="{Binding Opacity}">
                            <Border Style="{StaticResource RowBorder}" Padding="8,6,4,6" Margin="0,1,0,0"
                                    ContextMenu="{StaticResource RowMenu}"
                                    MouseLeftButtonUp="Row_MouseLeftButtonUp" ToolTip="{Binding Info.Cwd}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}" Style="{StaticResource PulseDot}"
                                             VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Grid Margin="0,1,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="11" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding StatusText, Mode=OneWay}" Foreground="{Binding DotBrush, Mode=OneWay}"/>
                                                <Run Text=" · " Foreground="{DynamicResource SubtleBrush}"/>
                                                <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource SubtleBrush}"/>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,2,0">
                                        <!-- 백그라운드 작업 열고 닫기 -->
                                        <Button Style="{StaticResource ChipButton}" Margin="0,0,6,0"
                                                Click="TasksToggle_Click" ToolTip="{Binding TasksTip}"
                                                Visibility="{Binding HasTasks, Converter={StaticResource BoolToVis}}">
                                            <TextBlock FontSize="10.5">
                                                <Run Text="{Binding TasksChevron, Mode=OneWay}"/>
                                                <Run Text="{Binding TasksCountText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Button>
                                        <!-- 컨텍스트(자동 압축 기준 %) · 압축 버튼 -->
                                        <TextBlock Text="{Binding ContextLabel}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding ContextBrush}" ToolTip="{Binding ContextTip}"
                                                   Visibility="{Binding HasContext, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{StaticResource IconButton}" Width="18" Height="20" FontSize="12" Margin="1,0,0,0"
                                                Content="{Binding CompactLabel}" Foreground="{Binding CompactBrush}"
                                                Click="Compact_Click" ToolTip="{Binding CompactTip}" IsEnabled="{Binding CanRequestCompact}"
                                                Visibility="{Binding ShowCompact, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="{Binding Star}"
                                            Foreground="{Binding StarBrush}" VerticalAlignment="Top"
                                            Click="Star_Click" ToolTip="즐겨찾기: 확인해도 항상 표시"/>
                                </Grid>
                            </Border>

                            <!-- 백그라운드 작업: 상위 세션 바로 아래 -->
                            <ItemsControl ItemsSource="{Binding Tasks}" Margin="22,0,4,2" Focusable="False"
                                          Visibility="{Binding ShowTasks, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:TaskRow}">
                                        <Border Style="{StaticResource RowBorder}" Padding="6,3" MouseLeftButtonUp="Task_MouseLeftButtonUp">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="6" Height="6" Fill="{Binding DotBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{DynamicResource TaskTextBrush}" FontSize="11.5"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{DynamicResource SubtleBrush}"
                                                           FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="EmptyText" Text="확인할 세션이 없어요" Foreground="{DynamicResource SubtleBrush}"
                       FontSize="11.5" Margin="8,2,8,4"/>
            </StackPanel>

            <!-- 맨 아래 줄: [테마] 5시간 사용량 [음성 알림]. 접어도 보인다 -->
            <Grid x:Name="FooterPanel" Margin="2,4,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ThemeToggleButton" Style="{StaticResource IconButton}" FontSize="12"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Click="ThemeToggle_Click"/>
                <TextBlock Grid.Column="1" Text="세션 한도" ToolTip="5시간 세션 한도" Foreground="{DynamicResource SubtleBrush}" FontSize="10.5" Margin="4,0,8,0" VerticalAlignment="Center"/>
                <Border x:Name="FiveHourTrack" Grid.Column="2" Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}"
                        VerticalAlignment="Center">
                    <Border x:Name="FiveHourFill" HorizontalAlignment="Left" CornerRadius="2"/>
                </Border>
                <TextBlock x:Name="FiveHourText" Grid.Column="3" FontSize="10.5" Margin="8,0,4,0" VerticalAlignment="Center">
                    <Run x:Name="FiveHourPercentText"/>
                    <Run x:Name="FiveHourResetText" Foreground="{DynamicResource SubtleBrush}"/>
                </TextBlock>
                <StackPanel x:Name="VoicePanel" Grid.Column="4" Orientation="Horizontal" Margin="4,0,6,0" Background="Transparent"
                            MouseLeftButtonUp="VoicePanel_MouseLeftButtonUp">
                    <TextBlock Text="TTS" Foreground="{DynamicResource SubtleBrush}" FontSize="10.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="VoiceToggle" Style="{StaticResource SwitchToggle}" Click="VoiceToggle_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
