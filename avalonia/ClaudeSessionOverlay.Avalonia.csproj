<Project Sdk="Microsoft.NET.Sdk">

  <!-- macOS·Windows·Linux에서 도는 오버레이(Avalonia). Windows 전용 WPF 앱(app/)과 같은 코어를 쓴다 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClaudeSessionOverlay</AssemblyName>
    <RootNamespace>ClaudeSessionOverlay</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.2.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <!-- Windows에서만 쓴다(음성 알림). 다른 OS에서는 불리지 않는다 -->
    <PackageReference Include="System.Speech" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\ClaudeSessionOverlay.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\assets\icon\icon-64.png" Link="Assets\icon-64.png" />
  </ItemGroup>

  <!-- macOS 메뉴 막대·위젯 다리(Swift). scripts/make-macos-app.sh가 macos/build에 만든다. 있으면 dotnet run에서도 쓴다 -->
  <ItemGroup Condition="Exists('..\macos\build\libClaudeOverlayMac.dylib')">
    <None Include="..\macos\build\libClaudeOverlayMac.dylib" Link="libClaudeOverlayMac.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
