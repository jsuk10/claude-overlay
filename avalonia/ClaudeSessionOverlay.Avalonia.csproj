<Project Sdk="Microsoft.NET.Sdk">

  <!-- macOS·Windows·Linux에서 도는 오버레이(Avalonia). Windows 전용 WPF 앱(app/)과 같은 코어를 쓴다 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClaudeSessionOverlay</AssemblyName>
    <RootNamespace>ClaudeSessionOverlay</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <!-- Windows에서만 쓴다(음성 알림). 다른 OS에서는 불리지 않는다 -->
    <PackageReference Include="System.Speech" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\ClaudeSessionOverlay.Core.csproj" />
  </ItemGroup>

</Project>
