// 소개 페이지(docs/)를 Cloudflare Workers 정적 자산으로 배포한다: npx --yes wrangler deploy
{
  "name": "claude-overlay",
  "compatibility_date": "2026-10-01",
  "main": "worker.js",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": ["/naver*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "workers_dev": true,
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "claude-overlay.jsuk.cloud", "custom_domain": true }
  ]
}
